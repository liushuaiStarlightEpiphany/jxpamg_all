         #pragma omp parallel for
         for (i = 0; i < nLU; i++) 
         {
            ytemp_data[i] = unew_data[i];
         }
      }

      #pragma omp parallel for
      for (i = 0; i < nLU; i++) 
      {
         utemp_data[i] = 0;
      }
      
      for ( kk = 0; kk < upper_jacobi_iters; kk++ ) 
      {
         jx_CSRMatrixMatvec_Jacobi_spu(1, U_diag, utemp_data, D, ytemp_data, my_id,unew_data);
