JX_Int
jx_JacobiTriangularSolve_spmv2(jx_ParCSRMatrix *A,
                     jx_ParVector    *f,
                     jx_ParVector    *u,
                     JX_Int          *perm,
                     JX_Int           nLU,
                     jx_ParCSRMatrix *L,
                     JX_Real         *D,
                     jx_ParCSRMatrix *U,
                     jx_ParVector    *ftemp,
                     jx_ParVector    *utemp,
                     JX_Int           maxIter,
                     JX_Int           lower_jacobi_iters,
                     JX_Int           upper_jacobi_iters,
                     JX_Int           my_id)
{
   /* Data objects for L and U */
   jx_CSRMatrix *L_diag      = jx_ParCSRMatrixDiag(L);
   JX_Real      *L_diag_data = jx_CSRMatrixData(L_diag);
   JX_Int       *L_diag_i    = jx_CSRMatrixI(L_diag);
   JX_Int       *L_diag_j    = jx_CSRMatrixJ(L_diag);
   jx_CSRMatrix *U_diag      = jx_ParCSRMatrixDiag(U);
   JX_Real      *U_diag_data = jx_CSRMatrixData(U_diag);
   JX_Int       *U_diag_i    = jx_CSRMatrixI(U_diag);
   JX_Int       *U_diag_j    = jx_CSRMatrixJ(U_diag);

   /* Vectors */
   jx_Vector    *utemp_local = jx_ParVectorLocalVector(utemp);
   JX_Real      *utemp_data  = jx_VectorData(utemp_local);
   jx_Vector    *ftemp_local = jx_ParVectorLocalVector(ftemp);
   JX_Real      *ftemp_data  = jx_VectorData(ftemp_local);
   
   JX_Real       alpha       = -1.0;
   JX_Real       beta        = 1.0;
   JX_Real       sum;
   JX_Int        i, j, k1, k2, kk,iter;


   jx_ParVectorCopy(f, ftemp);
   jx_ParCSRMatrixMatvec(alpha, A, u, beta, ftemp);
   jx_Vector  *ytemp = jx_SeqVectorCreate(nLU);
   jx_SeqVectorInitialize(ytemp);
   JX_Real  *ytemp_data= jx_VectorData(ytemp);

   // jx_Vector  *unew = jx_SeqVectorCreate(nLU);
   // jx_SeqVectorInitialize(unew);
   // JX_Real  *unew_data= jx_VectorData(unew);

    /* 迭代 maxIter 次 */
    for (iter = 0; iter < maxIter; iter++) 
    {
      #pragma omp parallel for
      for (i = 0; i < nLU; i++) 
      {
         ytemp_data[i] = 0;
      }

      /* Jacobi iteration loop */
      for ( kk = 0; kk < lower_jacobi_iters; kk++ )  //lower_jacobi_iters
      {
         switch (jx_jacobi_type)
         {
         default: //调用dot
            jx_CSRMatrixMatvec_Jacobi(0, L_diag, ytemp, D, ftemp_data, my_id);
            break;
         case 1:  //更改DMA版本
            jx_CSRMatrixMatvec_dotJacobi_dma(0, L_diag, ytemp, D, ftemp_data, my_id);
            break;
         case 2:  //更改GSM版本
            jx_CSRMatrixMatvec_dotJacobi_GSM(0, L_diag, ytemp, D, ftemp_data, my_id);
            break;
         }
      }

      #pragma omp parallel for
      for (i = 0; i < nLU; i++) 
      {
         utemp_data[i] = 0;
      }

      /* Jacobi iteration loop */
      for ( kk = 0; kk < upper_jacobi_iters; kk++ )  //upper_jacobi_iters
      { /* Jacobi iteration loop */
         for ( kk = 0; kk < upper_jacobi_iters; kk++ )  //upper_jacobi_iters
         {
            switch (jx_jacobi_type)
            {
            default: //dot
               jx_CSRMatrixMatvec_Jacobi(1, U_diag, utemp_local, D, ytemp_data, my_id);
               break;
            case 1:  //更改GSM版本
               jx_CSRMatrixMatvec_dotJacobi_dma(1, U_diag, utemp_local, D, ytemp_data, my_id);
               break;
            case 2:  //更改GSM版本
            jx_CSRMatrixMatvec_dotJacobi_GSM(1, U_diag, utemp_local, D, ytemp_data, my_id);
               break;
            }
         }
      }

      jx_ParCSRMatrixMatvec(alpha, A, utemp, beta, ftemp);
      jx_ParVectorAxpy(beta, utemp, u);
   }

   // jx_TFree(u_new);
   jx_SeqVectorDestroy(ytemp); 
   // jx_SeqVectorDestroy(unew); 

   return jx_error_flag;
}



JX_Int
jx_JacobiTriangularSolve_spmv3(jx_ParCSRMatrix *A,
                     jx_ParVector    *f,
                     jx_ParVector    *u,
                     JX_Int          *perm,
                     JX_Int           nLU,
                     jx_ParCSRMatrix *L,
                     jx_ParVector    *vec_D,
                     // JX_Real         *D,
                     jx_ParCSRMatrix *U,
                     jx_ParVector    *ftemp,
                     jx_ParVector    *utemp,
                     JX_Int           maxIter,
                     JX_Int           lower_jacobi_iters,
                     JX_Int           upper_jacobi_iters,
                     JX_Int           my_id)
{
   /* Data objects for L and U */
   jx_CSRMatrix *L_diag      = jx_ParCSRMatrixDiag(L);
   JX_Real      *L_diag_data = jx_CSRMatrixData(L_diag);
   JX_Int       *L_diag_i    = jx_CSRMatrixI(L_diag);
   JX_Int       *L_diag_j    = jx_CSRMatrixJ(L_diag);
   jx_CSRMatrix *U_diag      = jx_ParCSRMatrixDiag(U);
   JX_Real      *U_diag_data = jx_CSRMatrixData(U_diag);
   JX_Int       *U_diag_i    = jx_CSRMatrixI(U_diag);
   JX_Int       *U_diag_j    = jx_CSRMatrixJ(U_diag);

   /* Vectors */
   jx_Vector    *utemp_local = jx_ParVectorLocalVector(utemp);
   JX_Real      *utemp_data  = jx_VectorData(utemp_local);
   jx_Vector    *ftemp_local = jx_ParVectorLocalVector(ftemp);
   JX_Real      *ftemp_data  = jx_VectorData(ftemp_local);

   jx_Vector    *D_local = jx_ParVectorLocalVector(vec_D);
   JX_Real      *D  = jx_VectorData(D_local);
   
   JX_Real       alpha       = -1.0;
   JX_Real       beta        = 1.0;
   JX_Real       sum;
   JX_Int        i, j, k1, k2, kk,iter;


   jx_ParVectorCopy(f, ftemp);
   jx_ParCSRMatrixMatvec(alpha, A, u, beta, ftemp);
   jx_Vector  *ytemp = jx_SeqVectorCreate(nLU);
   jx_SeqVectorInitialize(ytemp);
   JX_Real  *ytemp_data= jx_VectorData(ytemp);

   // jx_Vector  *unew = jx_SeqVectorCreate(nLU);
   // jx_SeqVectorInitialize(unew);
   // JX_Real  *unew_data= jx_VectorData(unew);

    /* 迭代 maxIter 次 */
    for (iter = 0; iter < maxIter; iter++) 
    {
      #pragma omp parallel for
      for (i = 0; i < nLU; i++) 
      {
         ytemp_data[i] = 0;
      }
      /* Jacobi iteration loop */
      for ( kk = 0; kk < lower_jacobi_iters; kk++ )  //lower_jacobi_iters
      {
         switch (jx_jacobi_type)
         {
         default: //调用baseline版本DMA
            jx_CSRMatrixMatvec_Jacobi_baseline(0, L_diag, ytemp, D_local, ftemp_local, my_id);
            break;
         case 1:  //baseline更改GSM版本
            jx_CSRMatrixMatvec_Jacobi_GSM(0, L_diag, ytemp, D_local, ftemp_local, my_id);  //孙老师版本
            break;
         case 2:  //baseline版本DMA计算y = (b-AX)/d
            jx_CSRMatrixMatvec_Jacobi_total(0, L_diag, ytemp, D_local, ftemp_local, my_id);
            break;
         case 3:  //baseline版本计算y = (b-AX)/d
            jx_CSRMatrixMatvec_Jacobi_totalGSM(0, L_diag, ytemp, D_local, ftemp_local, my_id);
            break;
         }
      }

      #pragma omp parallel for
      for (i = 0; i < nLU; i++) 
      {
         utemp_data[i] = 0;
      }

      /* Jacobi iteration loop */
      for ( kk = 0; kk < upper_jacobi_iters; kk++ )  //upper_jacobi_iters
      {
         switch (jx_jacobi_type)
         {
         default: //调用baseline版本DMA
            jx_CSRMatrixMatvec_Jacobi_baseline(1, U_diag, utemp_local, D_local, ytemp, my_id);
            break;
         case 1:  //baseline更改GSM版本
            jx_CSRMatrixMatvec_Jacobi_GSM(1, U_diag, utemp_local, D_local, ytemp, my_id);
            break;
         case 2:  //baseline版本DMA计算y = (b-AX)/d
            jx_CSRMatrixMatvec_Jacobi_total(1, U_diag, utemp_local, D_local, ytemp, my_id);
            break;
         case 3:  //baseline版本GSM计算y = (b-AX)/d
            jx_CSRMatrixMatvec_Jacobi_totalGSM(1, U_diag, utemp_local, D_local, ytemp, my_id);
            break;
         }
      }

      jx_ParCSRMatrixMatvec(alpha, A, utemp, beta, ftemp);
      jx_ParVectorAxpy(beta, utemp, u);
   }

   // jx_TFree(u_new);
   jx_SeqVectorDestroy(ytemp); 
   // jx_SeqVectorDestroy(unew); 

   return jx_error_flag;
}


