// 内部辅助宏和函数
#define JX_MIN(a, b) ((a) < (b) ? (a) : (b))
#define JX_MAX(a, b) ((a) > (b) ? (a) : (b))
#define JX_ABS(x) ((x) >= 0 ? (x) : -(x))

// 交换两个数
#define JX_SWAP(a, b) \
    do { \
        JX_Real temp = (a); \
        (a) = (b); \
        (b) = temp; \
    } while (0)

