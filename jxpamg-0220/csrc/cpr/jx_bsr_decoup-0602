/*========================================================================*
 *                       基础矩阵运算函数（保持不变）                      *
 *========================================================================*/
// 2x2矩阵求逆
static void jx_smat_inv_2x2(JX_Real* a) {
    const JX_Real a11 = a[0], a12 = a[1];
    const JX_Real a21 = a[2], a22 = a[3];
    
    const JX_Real det = a11 * a22 - a12 * a21;
    
    if (JX_ABS(det) < 1e-15) {
        // 接近奇异，设为单位阵
        a[0] = 1.0; a[1] = 0.0;
        a[2] = 0.0; a[3] = 1.0;
    } else {
        JX_Real det_inv = 1.0 / det;
        a[0] =  a22 * det_inv;
        a[1] = -a12 * det_inv;
        a[2] = -a21 * det_inv;
        a[3] =  a11 * det_inv;
    }
}

// 3x3矩阵求逆
static void jx_smat_inv_3x3(JX_Real* a) {
    const JX_Real a11 = a[0], a12 = a[1], a13 = a[2];
    const JX_Real a21 = a[3], a22 = a[4], a23 = a[5];
    const JX_Real a31 = a[6], a32 = a[7], a33 = a[8];
    
    // 计算余子式
    const JX_Real M11 = a22 * a33 - a23 * a32;
    const JX_Real M12 = a21 * a33 - a23 * a31;
    const JX_Real M13 = a21 * a32 - a22 * a31;
    const JX_Real M21 = a12 * a33 - a13 * a32;
    const JX_Real M22 = a11 * a33 - a13 * a31;
    const JX_Real M23 = a11 * a32 - a12 * a31;
    const JX_Real M31 = a12 * a23 - a13 * a22;
    const JX_Real M32 = a11 * a23 - a13 * a21;
    const JX_Real M33 = a11 * a22 - a12 * a21;
    
    // 计算行列式
    const JX_Real det = a11 * M11 - a12 * M12 + a13 * M13;
    
    if (JX_ABS(det) < 1e-15) {
        // 接近奇异，设为单位阵
        for (int i = 0; i < 9; i++) a[i] = 0.0;
        a[0] = a[4] = a[8] = 1.0;
    } else {
        JX_Real det_inv = 1.0 / det;
        // 伴随矩阵并转置
        a[0] =  M11 * det_inv;
        a[1] = -M21 * det_inv;
        a[2] =  M31 * det_inv;
        a[3] = -M12 * det_inv;
        a[4] =  M22 * det_inv;
        a[5] = -M32 * det_inv;
        a[6] =  M13 * det_inv;
        a[7] = -M23 * det_inv;
        a[8] =  M33 * det_inv;
    }
}

// 4x4矩阵求逆（油藏模拟常用）
static void jx_smat_inv_4x4(JX_Real* a) {
    const JX_Real a11 = a[0], a12 = a[1], a13 = a[2], a14 = a[3];
    const JX_Real a21 = a[4], a22 = a[5], a23 = a[6], a24 = a[7];
    const JX_Real a31 = a[8], a32 = a[9], a33 = a[10], a34 = a[11];
    const JX_Real a41 = a[12], a42 = a[13], a43 = a[14], a44 = a[15];
    
    // 计算余子式
    const JX_Real M11 = a22*a33*a44 + a23*a34*a42 + a24*a32*a43 
                       - a22*a34*a43 - a23*a32*a44 - a24*a33*a42;
    const JX_Real M12 = a12*a34*a43 + a13*a32*a44 + a14*a33*a42 
                       - a12*a33*a44 - a13*a34*a42 - a14*a32*a43;
    const JX_Real M13 = a12*a23*a44 + a13*a24*a42 + a14*a22*a43 
                       - a12*a24*a43 - a13*a22*a44 - a14*a23*a42;
    const JX_Real M14 = a12*a24*a33 + a13*a22*a34 + a14*a23*a32 
                       - a12*a23*a34 - a13*a24*a32 - a14*a22*a33;
    
    const JX_Real det = a11*M11 - a12*M12 + a13*M13 - a14*M14;
    
    if (JX_ABS(det) < 1e-15) {
        // 接近奇异，设为单位阵
        for (int i = 0; i < 16; i++) a[i] = 0.0;
        a[0] = a[5] = a[10] = a[15] = 1.0;
    } else {
        JX_Real det_inv = 1.0 / det;
        
        // 继续计算其他余子式
        const JX_Real M21 = a21*a34*a43 + a23*a31*a44 + a24*a33*a41 
                           - a21*a33*a44 - a23*a34*a41 - a24*a31*a43;
        const JX_Real M22 = a11*a33*a44 + a13*a34*a41 + a14*a31*a43 
                           - a11*a34*a43 - a13*a31*a44 - a14*a33*a41;
        const JX_Real M23 = a11*a24*a43 + a13*a21*a44 + a14*a23*a41 
                           - a11*a23*a44 - a13*a24*a41 - a14*a21*a43;
        const JX_Real M24 = a11*a23*a34 + a13*a24*a31 + a14*a21*a33 
                           - a11*a24*a33 - a13*a21*a34 - a14*a23*a31;
        
        const JX_Real M31 = a21*a32*a44 + a22*a34*a41 + a24*a31*a42 
                           - a21*a34*a42 - a22*a31*a44 - a24*a32*a41;
        const JX_Real M32 = a11*a34*a42 + a12*a31*a44 + a14*a32*a41 
                           - a11*a32*a44 - a12*a34*a41 - a14*a31*a42;
        const JX_Real M33 = a11*a22*a44 + a12*a24*a41 + a14*a21*a42 
                           - a11*a24*a42 - a12*a21*a44 - a14*a22*a41;
        const JX_Real M34 = a11*a24*a32 + a12*a21*a34 + a14*a22*a31 
                           - a11*a22*a34 - a12*a24*a31 - a14*a21*a32;
        
        const JX_Real M41 = a21*a33*a42 + a22*a31*a43 + a23*a32*a41 
                           - a21*a32*a43 - a22*a33*a41 - a23*a31*a42;
        const JX_Real M42 = a11*a32*a43 + a12*a33*a41 + a13*a31*a42 
                           - a11*a33*a42 - a12*a31*a43 - a13*a32*a41;
        const JX_Real M43 = a11*a23*a42 + a12*a21*a43 + a13*a22*a41 
                           - a11*a22*a43 - a12*a23*a41 - a13*a21*a42;
        const JX_Real M44 = a11*a22*a33 + a12*a23*a31 + a13*a21*a32 
                           - a11*a23*a32 - a12*a21*a33 - a13*a22*a31;
        
        // 伴随矩阵并转置
        a[0]  =  M11 * det_inv;
        a[1]  = -M21 * det_inv;
        a[2]  =  M31 * det_inv;
        a[3]  = -M41 * det_inv;
        a[4]  = -M12 * det_inv;
        a[5]  =  M22 * det_inv;
        a[6]  = -M32 * det_inv;
        a[7]  =  M42 * det_inv;
        a[8]  =  M13 * det_inv;
        a[9]  = -M23 * det_inv;
        a[10] =  M33 * det_inv;
        a[11] = -M43 * det_inv;
        a[12] = -M14 * det_inv;
        a[13] =  M24 * det_inv;
        a[14] = -M34 * det_inv;
        a[15] =  M44 * det_inv;
    }
}

// 通用n×n矩阵求逆（高斯消元法）
static void jx_smat_inv_nc(JX_Real* a, JX_Int n) {
    if (n == 1) {
        a[0] = (JX_ABS(a[0]) > 1e-15) ? 1.0 / a[0] : 1.0;
        return;
    } else if (n == 2) {
        jx_smat_inv_2x2(a);
        return;
    } else if (n == 3) {
        jx_smat_inv_3x3(a);
        return;
    } else if (n == 4) {
        jx_smat_inv_4x4(a);
        return;
    }
    
    // 对于更大的块，使用高斯消元法
    JX_Int i, j, k, max_idx;
    JX_Real max_val, tmp;
    JX_Int* pivot = (JX_Int*)malloc(n * sizeof(JX_Int));
    
    // 初始化pivot数组
    for (i = 0; i < n; i++) pivot[i] = i;
    
    // 高斯消元（部分选主元）
    for (i = 0; i < n; i++) {
        // 查找主元
        max_val = JX_ABS(a[i*n + i]);
        max_idx = i;
        for (j = i+1; j < n; j++) {
            if (JX_ABS(a[j*n + i]) > max_val) {
                max_val = JX_ABS(a[j*n + i]);
                max_idx = j;
            }
        }
        
        // 如果主元太小，矩阵可能奇异
        if (max_val < 1e-15) {
            free(pivot);
            // 设为单位阵
            for (j = 0; j < n*n; j++) a[j] = 0.0;
            for (j = 0; j < n; j++) a[j*n + j] = 1.0;
            return;
        }
        
        // 交换行
        if (max_idx != i) {
            for (j = 0; j < n; j++) {
                JX_SWAP(a[i*n + j], a[max_idx*n + j]);
            }
            JX_SWAP(pivot[i], pivot[max_idx]);
        }
        
        // 归一化当前行
        tmp = a[i*n + i];
        for (j = 0; j < n; j++) {
            a[i*n + j] /= tmp;
        }
        
        // 消去其他行
        for (j = 0; j < n; j++) {
            if (j != i) {
                tmp = a[j*n + i];
                for (k = 0; k < n; k++) {
                    a[j*n + k] -= tmp * a[i*n + k];
                }
            }
        }
    }
    
    // 根据pivot重新排列列
    JX_Real* temp = (JX_Real*)malloc(n * sizeof(JX_Real));
    for (i = 0; i < n; i++) {
        if (pivot[i] != i) {
            // 保存第i列
            for (j = 0; j < n; j++) temp[j] = a[j*n + i];
            // 复制pivot[i]列到第i列
            for (j = 0; j < n; j++) a[j*n + i] = a[j*n + pivot[i]];
            // 将temp复制到pivot[i]列
            for (j = 0; j < n; j++) a[j*n + pivot[i]] = temp[j];
            
            // 更新pivot
            for (j = i+1; j < n; j++) {
                if (pivot[j] == i) {
                    pivot[j] = pivot[i];
                    break;
                }
            }
        }
    }
    
    free(temp);
    free(pivot);
}

// 创建单位矩阵
static void jx_smat_identity(JX_Real* A, JX_Int n) {
    JX_Int i, j;
    for (i = 0; i < n; i++) {
        for (j = 0; j < n; j++) {
            A[i*n + j] = (i == j) ? 1.0 : 0.0;
        }
    }
}

// 矩阵乘法：C = A * B
static void jx_smat_mul(JX_Real* A, JX_Real* B, JX_Real* C, JX_Int n) {
    JX_Int i, j, k;
    for (i = 0; i < n; i++) {
        for (j = 0; j < n; j++) {
            C[i*n + j] = 0.0;
            for (k = 0; k < n; k++) {
                C[i*n + j] += A[i*n + k] * B[k*n + j];
            }
        }
    }
}

// 2x2矩阵乘法优化
static void jx_smat_mul_2x2(JX_Real* A, JX_Real* B, JX_Real* C) {
    C[0] = A[0]*B[0] + A[1]*B[2];
    C[1] = A[0]*B[1] + A[1]*B[3];
    C[2] = A[2]*B[0] + A[3]*B[2];
    C[3] = A[2]*B[1] + A[3]*B[3];
}

// 4x4矩阵乘法优化
static void jx_smat_mul_4x4(JX_Real* A, JX_Real* B, JX_Real* C) {
    C[0] = A[0]*B[0] + A[1]*B[4] + A[2]*B[8] + A[3]*B[12];
    C[1] = A[0]*B[1] + A[1]*B[5] + A[2]*B[9] + A[3]*B[13];
    C[2] = A[0]*B[2] + A[1]*B[6] + A[2]*B[10] + A[3]*B[14];
    C[3] = A[0]*B[3] + A[1]*B[7] + A[2]*B[11] + A[3]*B[15];
    
    C[4] = A[4]*B[0] + A[5]*B[4] + A[6]*B[8] + A[7]*B[12];
    C[5] = A[4]*B[1] + A[5]*B[5] + A[6]*B[9] + A[7]*B[13];
    C[6] = A[4]*B[2] + A[5]*B[6] + A[6]*B[10] + A[7]*B[14];
    C[7] = A[4]*B[3] + A[5]*B[7] + A[6]*B[11] + A[7]*B[15];
    
    C[8] = A[8]*B[0] + A[9]*B[4] + A[10]*B[8] + A[11]*B[12];
    C[9] = A[8]*B[1] + A[9]*B[5] + A[10]*B[9] + A[11]*B[13];
    C[10] = A[8]*B[2] + A[9]*B[6] + A[10]*B[10] + A[11]*B[14];
    C[11] = A[8]*B[3] + A[9]*B[7] + A[10]*B[11] + A[11]*B[15];
    
    C[12] = A[12]*B[0] + A[13]*B[4] + A[14]*B[8] + A[15]*B[12];
    C[13] = A[12]*B[1] + A[13]*B[5] + A[14]*B[9] + A[15]*B[13];
    C[14] = A[12]*B[2] + A[13]*B[6] + A[14]*B[10] + A[15]*B[14];
    C[15] = A[12]*B[3] + A[13]*B[7] + A[14]*B[11] + A[15]*B[15];
}

// 矩阵向量乘法：c = A * b
static void jx_smat_vec_mul(JX_Real* A, JX_Real* b, JX_Real* c, JX_Int n) {
    JX_Int i, j;
    for (i = 0; i < n; i++) {
        c[i] = 0.0;
        for (j = 0; j < n; j++) {
            c[i] += A[i*n + j] * b[j];
        }
    }
}

// 2x2矩阵向量乘法优化
static void jx_smat_vec_mul_2(JX_Real* A, JX_Real* b, JX_Real* c) {
    c[0] = A[0]*b[0] + A[1]*b[1];
    c[1] = A[2]*b[0] + A[3]*b[1];
}

// 4x4矩阵向量乘法优化
static void jx_smat_vec_mul_4(JX_Real* A, JX_Real* b, JX_Real* c) {
    c[0] = A[0]*b[0] + A[1]*b[1] + A[2]*b[2] + A[3]*b[3];
    c[1] = A[4]*b[0] + A[5]*b[1] + A[6]*b[2] + A[7]*b[3];
    c[2] = A[8]*b[0] + A[9]*b[1] + A[10]*b[2] + A[11]*b[3];
    c[3] = A[12]*b[0] + A[13]*b[1] + A[14]*b[2] + A[15]*b[3];
}

/*========================================================================*
 *                       解耦算法实现（同时处理矩阵和右端项）              *
 *========================================================================*/

// ABF解耦（2x2块专用优化版本）
static void jx_decouple_abf_2x2(JX_Real* val, JX_Real* rhs, JX_Int* rpt, 
                               JX_Int* cpt, JX_Int nrow) {
    const JX_Int nb = 2;
    const JX_Int nb2 = nb * nb;
    
    JX_Real binv[4];  // 逆矩阵
    JX_Real smat[4];  // 临时矩阵
    JX_Real svec[2];  // 临时向量
    
    JX_Int i, j, ibegin, iend;
    JX_Int block_idx = 0;
    
    for (i = 0; i < nrow; ++i) {
        // 获取对角块并求逆
        binv[0] = val[block_idx * nb2 + 0];
        binv[1] = val[block_idx * nb2 + 1];
        binv[2] = val[block_idx * nb2 + 2];
        binv[3] = val[block_idx * nb2 + 3];
        
        jx_smat_inv_2x2(binv);
        
        ibegin = rpt[i];
        iend = rpt[i + 1];
        
        // 处理这一行的所有矩阵块
        for (j = ibegin; j < iend; ++j) {
            JX_Real* block = val + (block_idx + (j - ibegin)) * nb2;
            
            if (j == ibegin) {
                // 对角块设为单位阵
                block[0] = 1.0; block[1] = 0.0;
                block[2] = 0.0; block[3] = 1.0;
            } else {
                // 非对角块：smat = binv * block
                jx_smat_mul_2x2(binv, block, smat);
                block[0] = smat[0]; block[1] = smat[1];
                block[2] = smat[2]; block[3] = smat[3];
            }
        }
        
        // 处理右端项：svec = binv * rhs
        svec[0] = rhs[i * nb];
        svec[1] = rhs[i * nb + 1];
        
        jx_smat_vec_mul_2(binv, svec, svec);
        
        rhs[i * nb] = svec[0];
        rhs[i * nb + 1] = svec[1];
        
        block_idx += (iend - ibegin);
    }
}

// ABF解耦（4x4块专用优化版本）
static void jx_decouple_abf_4x4(JX_Real* val, JX_Real* rhs, JX_Int* rpt, 
                               JX_Int* cpt, JX_Int nrow) {
    const JX_Int nb = 4;
    const JX_Int nb2 = nb * nb;
    
    JX_Real* binv = (JX_Real*)malloc(nb2 * sizeof(JX_Real));
    JX_Real* smat = (JX_Real*)malloc(nb2 * sizeof(JX_Real));
    JX_Real* svec = (JX_Real*)malloc(nb * sizeof(JX_Real));
    
    JX_Int i, j, ibegin, iend;
    JX_Int block_idx = 0;
    
    for (i = 0; i < nrow; ++i) {
        // 获取对角块并求逆
        memcpy(binv, val + block_idx * nb2, nb2 * sizeof(JX_Real));
        jx_smat_inv_4x4(binv);
        
        ibegin = rpt[i];
        iend = rpt[i + 1];
        
        // 处理这一行的所有矩阵块
        for (j = ibegin; j < iend; ++j) {
            JX_Real* block = val + (block_idx + (j - ibegin)) * nb2;
            
            if (j == ibegin) {
                // 对角块设为单位阵
                jx_smat_identity(block, nb);
            } else {
                // 非对角块：smat = binv * block
                jx_smat_mul_4x4(binv, block, smat);
                memcpy(block, smat, nb2 * sizeof(JX_Real));
            }
        }
        
        // 处理右端项：svec = binv * rhs
        memcpy(svec, rhs + i * nb, nb * sizeof(JX_Real));
        jx_smat_vec_mul_4(binv, svec, svec);
        memcpy(rhs + i * nb, svec, nb * sizeof(JX_Real));
        
        block_idx += (iend - ibegin);
    }
    
    free(binv);
    free(smat);
    free(svec);
}

// ABF解耦（通用版本）
static void jx_decouple_abf_nb(JX_Real* val, JX_Real* rhs, JX_Int* rpt, 
                              JX_Int* cpt, JX_Int nb, JX_Int nrow) {
    const JX_Int nb2 = nb * nb;
    
    JX_Real* binv = (JX_Real*)malloc(nb2 * sizeof(JX_Real));
    JX_Real* smat = (JX_Real*)malloc(nb2 * sizeof(JX_Real));
    JX_Real* svec = (JX_Real*)malloc(nb * sizeof(JX_Real));
    
    JX_Int i, j, ibegin, iend;
    JX_Int block_idx = 0;
    
    for (i = 0; i < nrow; ++i) {
        // 获取对角块并求逆
        memcpy(binv, val + block_idx * nb2, nb2 * sizeof(JX_Real));
        jx_smat_inv_nc(binv, nb);
        
        ibegin = rpt[i];
        iend = rpt[i + 1];
        
        // 处理这一行的所有矩阵块
        for (j = ibegin; j < iend; ++j) {
            JX_Real* block = val + (block_idx + (j - ibegin)) * nb2;
            
            if (j == ibegin) {
                // 对角块设为单位阵
                jx_smat_identity(block, nb);
            } else {
                // 非对角块：smat = binv * block
                jx_smat_mul(binv, block, smat, nb);
                memcpy(block, smat, nb2 * sizeof(JX_Real));
            }
        }
        
        // 处理右端项：svec = binv * rhs
        memcpy(svec, rhs + i * nb, nb * sizeof(JX_Real));
        jx_smat_vec_mul(binv, svec, svec, nb);
        memcpy(rhs + i * nb, svec, nb * sizeof(JX_Real));
        
        block_idx += (iend - ibegin);
    }
    
    free(binv);
    free(smat);
    free(svec);
}

// ABF解耦（主函数）
static void jx_decouple_abf(JX_Real* val, JX_Real* rhs, JX_Int* rpt, 
                           JX_Int* cpt, JX_Int nb, JX_Int nrow) {
    switch (nb) {
        case 2:
            jx_decouple_abf_2x2(val, rhs, rpt, cpt, nrow);
            break;
        case 4:
            jx_decouple_abf_4x4(val, rhs, rpt, cpt, nrow);
            break;
        default:
            jx_decouple_abf_nb(val, rhs, rpt, cpt, nb, nrow);
            break;
    }
}

// 解析解耦（ANL）
static void jx_decouple_anl(JX_Real* val, JX_Real* rhs, JX_Int* rpt, 
                           JX_Int* cpt, JX_Int nb, JX_Int nrow, JX_Int is_thermal) {
    const JX_Int nb2 = nb * nb;
    
    JX_Real* binv = (JX_Real*)malloc(nb2 * sizeof(JX_Real));
    JX_Real* smat = (JX_Real*)malloc(nb2 * sizeof(JX_Real));
    JX_Real* svec = (JX_Real*)malloc(nb * sizeof(JX_Real));
    
    JX_Int i, j, l, ibegin, iend;
    JX_Int block_idx = 0;
    
    for (i = 0; i < nrow; ++i) {
        // 创建解析解耦矩阵（单位阵，第一行修改）
        jx_smat_identity(binv, nb);
        
        JX_Real* diag_block = val + block_idx * nb2;
        
        if (is_thermal) {
            /**
             * A =
             * [PP  PN1  PN2  ... PT ]
             * [N1P N1N1 N1N2 ... N1T]
             * [N2P N2N1 N2N2 ... N2T]
             *         ...
             * [TP  TN1  TN2  ... TT]
             * */
            for (l = 0; l < nb - 2; l++) {
                binv[1 + l] = -diag_block[1 + l];
                binv[(nb - 1) * nb + 1 + l] = -diag_block[(nb - 1) * nb + 1 + l];
            }
        } else {
            for (l = 0; l < nb - 1; l++) {
                binv[1 + l] = -diag_block[1 + l];
            }
        }
        
        ibegin = rpt[i];
        iend = rpt[i + 1];
        
        // 处理这一行的所有矩阵块
        for (j = ibegin; j < iend; ++j) {
            JX_Real* block = val + (block_idx + (j - ibegin)) * nb2;
            
            // smat = binv * block
            jx_smat_mul(binv, block, smat, nb);
            memcpy(block, smat, nb2 * sizeof(JX_Real));
        }
        
        // 处理右端项：svec = binv * rhs
        memcpy(svec, rhs + i * nb, nb * sizeof(JX_Real));
        jx_smat_vec_mul(binv, svec, svec, nb);
        memcpy(rhs + i * nb, svec, nb * sizeof(JX_Real));
        
        block_idx += (iend - ibegin);
    }
    
    free(binv);
    free(smat);
    free(svec);
}

// 半解析解耦（SEM）
static void jx_decouple_sem(JX_Real* val, JX_Real* rhs, JX_Int* rpt, 
                           JX_Int* cpt, JX_Int nb, JX_Int nrow, JX_Int is_thermal) {
    const JX_Int nb2 = nb * nb;
    
    JX_Real* binv = (JX_Real*)malloc(nb2 * sizeof(JX_Real));
    JX_Real* decoup_mat = (JX_Real*)malloc(nb2 * sizeof(JX_Real));
    JX_Real* smat = (JX_Real*)malloc(nb2 * sizeof(JX_Real));
    JX_Real* svec = (JX_Real*)malloc(nb * sizeof(JX_Real));
    
    JX_Int i, j, l, ibegin, iend;
    JX_Int block_idx = 0;
    
    for (i = 0; i < nrow; ++i) {
        // 步骤1：计算对角块的逆（ABF部分）
        memcpy(binv, val + block_idx * nb2, nb2 * sizeof(JX_Real));
        jx_smat_inv_nc(binv, nb);
        
        // 步骤2：用解析解耦替换第一行（和最后一行，如果是热力模型）
        memcpy(decoup_mat, binv, nb2 * sizeof(JX_Real));
        
        JX_Real* diag_block = val + block_idx * nb2;
        
        if (is_thermal) {
            // 热力模型：替换第一行和最后一行
            decoup_mat[0] = 1.0;
            decoup_mat[nb - 1] = 0.0;
            decoup_mat[(nb - 1) * nb] = 0.0;
            decoup_mat[nb2 - 1] = 1.0;
            
            for (l = 0; l < nb - 2; l++) {
                decoup_mat[1 + l] = -diag_block[1 + l];
                decoup_mat[(nb - 1) * nb + 1 + l] = -diag_block[(nb - 1) * nb + 1 + l];
            }
        } else {
            // 非热力模型：只替换第一行
            decoup_mat[0] = 1.0;
            for (l = 0; l < nb - 1; l++) {
                decoup_mat[1 + l] = -diag_block[1 + l];
            }
        }
        
        ibegin = rpt[i];
        iend = rpt[i + 1];
        
        // 处理这一行的所有矩阵块
        for (j = ibegin; j < iend; ++j) {
            JX_Real* block = val + (block_idx + (j - ibegin)) * nb2;
            
            // smat = decoup_mat * block
            jx_smat_mul(decoup_mat, block, smat, nb);
            memcpy(block, smat, nb2 * sizeof(JX_Real));
        }
        
        // 处理右端项：svec = decoup_mat * rhs
        memcpy(svec, rhs + i * nb, nb * sizeof(JX_Real));
        jx_smat_vec_mul(decoup_mat, svec, svec, nb);
        memcpy(rhs + i * nb, svec, nb * sizeof(JX_Real));
        
        block_idx += (iend - ibegin);
    }
    
    free(binv);
    free(decoup_mat);
    free(smat);
    free(svec);
}

// Quasi-IMPES解耦（QI）
static void jx_decouple_qi(JX_Real* val, JX_Real* rhs, JX_Int* rpt, 
                          JX_Int* cpt, JX_Int nb, JX_Int nrow, JX_Int is_thermal) {
    const JX_Int nb2 = nb * nb;
    
    JX_Real* decoup_mat = (JX_Real*)malloc(nb2 * sizeof(JX_Real));
    JX_Real* smat = (JX_Real*)malloc(nb2 * sizeof(JX_Real));
    JX_Real* svec = (JX_Real*)malloc(nb * sizeof(JX_Real));
    
    JX_Int i, j, l, ibegin, iend;
    JX_Int block_idx = 0;
    
    for (i = 0; i < nrow; ++i) {
        // 构建QI解耦矩阵
        jx_smat_identity(decoup_mat, nb);
        
        JX_Real* diag_block = val + block_idx * nb2;
        
        if (is_thermal) {
            // 热力模型
            for (l = 0; l < nb - 2; l++) {
                // 使用对角元归一化
                decoup_mat[1 + l] = -diag_block[1 + l] / diag_block[(l + 1) * nb + l + 1];
                decoup_mat[(nb - 1) * nb + 1 + l] = -diag_block[(nb - 1) * nb + 1 + l] / 
                                                   diag_block[(l + 1) * nb + l + 1];
            }
        } else {
            // 非热力模型
            for (l = 0; l < nb - 1; l++) {
                decoup_mat[1 + l] = -diag_block[1 + l] / diag_block[(l + 1) * nb + l + 1];
            }
        }
        
        ibegin = rpt[i];
        iend = rpt[i + 1];
        
        // 处理这一行的所有矩阵块
        for (j = ibegin; j < iend; ++j) {
            JX_Real* block = val + (block_idx + (j - ibegin)) * nb2;
            
            // smat = decoup_mat * block
            jx_smat_mul(decoup_mat, block, smat, nb);
            memcpy(block, smat, nb2 * sizeof(JX_Real));
        }
        
        // 处理右端项：svec = decoup_mat * rhs
        memcpy(svec, rhs + i * nb, nb * sizeof(JX_Real));
        jx_smat_vec_mul(decoup_mat, svec, svec, nb);
        memcpy(rhs + i * nb, svec, nb * sizeof(JX_Real));
        
        block_idx += (iend - ibegin);
    }
    
    free(decoup_mat);
    free(smat);
    free(svec);
}

/*========================================================================*
 *                       公共接口函数                                     *
 *========================================================================*/

JX_Int jx_BSRMatrixDecouple(jx_BSRMatrix* A_bsr, 
                           jx_Vector* rhs,
                           JX_DecoupType decoup_type,
                           JX_Int is_thermal) {
    if (A_bsr == NULL || rhs == NULL) {
        ERROR_PRINTF("jx_BSRMatrixDecouple: NULL matrix or rhs\n");
        return jx_error_flag;
    }
    
    JX_Int nb = jx_BSRMatrixBlockSize(A_bsr);
    JX_Int nrows = jx_BSRMatrixNumRows(A_bsr);
    JX_Int* rpt = jx_BSRMatrixI(A_bsr);
    JX_Int* cpt = jx_BSRMatrixJ(A_bsr);
    JX_Real* val = jx_BSRMatrixData(A_bsr);
    JX_Real* rhs_data = jx_VectorData(rhs);
    
    if (val == NULL || rhs_data == NULL || rpt == NULL || cpt == NULL) {
        ERROR_PRINTF("jx_BSRMatrixDecouple: Invalid matrix or rhs data\n");
        return jx_error_flag;
    }
    
    // 检查向量尺寸是否匹配
    if (jx_VectorSize(rhs) != nrows * nb) {
        ERROR_PRINTF("jx_BSRMatrixDecouple: RHS size mismatch. Expected %d, got %d\n",
                    nrows * nb, jx_VectorSize(rhs));
        return jx_error_flag;
    }
    
    // 检查块大小是否支持
    if (nb < 1 || nb > 10) {
        ERROR_PRINTF("jx_BSRMatrixDecouple: Unsupported block size %d\n", nb);
        return jx_error_flag;
    }
    
    // 根据解耦类型调用相应的函数
    switch (decoup_type) {
        case JX_DECOUP_NONE:
            // 不解耦，直接返回
            break;
            
        case JX_DECOUP_ABF:
            jx_decouple_abf(val, rhs_data, rpt, cpt, nb, nrows);
            break;
            
        case JX_DECOUP_ANL:
            jx_decouple_anl(val, rhs_data, rpt, cpt, nb, nrows, is_thermal);
            break;
            
        case JX_DECOUP_SEM:
            jx_decouple_sem(val, rhs_data, rpt, cpt, nb, nrows, is_thermal);
            break;
            
        case JX_DECOUP_QI:
            jx_decouple_qi(val, rhs_data, rpt, cpt, nb, nrows, is_thermal);
            break;
            
        default:
            ERROR_PRINTF("jx_BSRMatrixDecouple: Unknown decoupling type %d\n", decoup_type);
            return jx_error_flag;
    }
    
    return JX_SUCCESS;
}

JX_Int jx_ParBSRMatrixDecouple(jx_ParBSRMatrix* A_parbsr,
                              jx_ParVector* rhs,
                              JX_DecoupType decoup_type,
                              JX_Int is_thermal) {
    if (A_parbsr == NULL || rhs == NULL) {
        ERROR_PRINTF("jx_ParBSRMatrixDecouple: NULL matrix or rhs\n");
        return jx_error_flag;
    }
    
    int myid;
    MPI_Comm comm = jx_ParBSRMatrixComm(A_parbsr);
    MPI_Comm_rank(comm, &myid);
    
    // 获取对角部分和非对角部分
    jx_BSRMatrix* diag = jx_ParBSRMatrixDiag(A_parbsr);
    jx_BSRMatrix* offd = jx_ParBSRMatrixOffd(A_parbsr);
    
    if (diag == NULL) {
        ERROR_PRINTF("jx_ParBSRMatrixDecouple: NULL diagonal matrix\n");
        return jx_error_flag;
    }
    
    // 获取本地向量部分
    jx_Vector* local_rhs = jx_ParVectorLocalVector(rhs);
    if (local_rhs == NULL) {
        ERROR_PRINTF("jx_ParBSRMatrixDecouple: NULL local rhs\n");
        return jx_error_flag;
    }
    
    // 先解耦对角部分和本地右端项
    JX_Int result = jx_BSRMatrixDecouple(diag, local_rhs, decoup_type, is_thermal);
    if (result != JX_SUCCESS) {
        ERROR_PRINTF("jx_ParBSRMatrixDecouple: Failed to decouple diagonal part\n");
        return result;
    }
    
    // 如果存在非对角部分，也需要解耦（但不涉及右端项，因为非对角部分只连接其他进程）
    if (offd != NULL) {
        // 对于非对角部分，只解耦矩阵，不处理右端项
        // 创建一个临时的空向量作为占位符
        jx_Vector* temp_rhs = jx_SeqVectorCreate(jx_BSRMatrixNumRows(offd) * 
                                               jx_BSRMatrixBlockSize(offd));
        jx_SeqVectorInitialize(temp_rhs);
        
        result = jx_BSRMatrixDecouple(offd, temp_rhs, decoup_type, is_thermal);
        
        jx_SeqVectorDestroy(temp_rhs);
        
        if (result != JX_SUCCESS) {
            ERROR_PRINTF("jx_ParBSRMatrixDecouple: Failed to decouple off-diagonal part\n");
            return result;
        }
    }
    
    return JX_SUCCESS;
}

const char* jx_DecoupTypeToString(JX_DecoupType decoup_type) {
    switch (decoup_type) {
        case JX_DECOUP_NONE: return "NONE";
        case JX_DECOUP_ABF:  return "ABF";
        case JX_DECOUP_ANL:  return "ANL";
        case JX_DECOUP_SEM:  return "SEM";
        case JX_DECOUP_QI:   return "QI";
        default:             return "UNKNOWN";
    }
}